# Copiar a .env y ajustar a tu instalación de SQL Server (autenticación SQL)
PORT=4000
DB_SERVER=localhost
# Si usas una instancia con nombre (p. ej. SQLEXPRESS) define DB_INSTANCE y deja DB_PORT vacío
DB_INSTANCE=
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=TuPassword123
DB_NAME=BufetePopular
DB_ENCRYPT=false
DB_TRUST_CERT=true
